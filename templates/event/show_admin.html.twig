{% extends 'base.html.twig' %}

{% block title %}{{ event.title }} — Réservations Admin{% endblock %}

{% block body %}
<div class="container">

<nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="{{ path('admin_dashboard') }}">Dashboard</a></li>
        <li class="breadcrumb-item"><a href="{{ path('admin_event_index') }}">Événements</a></li>
        <li class="breadcrumb-item active">{{ event.title }}</li>
    </ol>
</nav>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <div class="row align-items-center">
            <div class="col-md-8">
                <h2 class="fw-bold mb-2">{{ event.title }}</h2>
                <div class="d-flex flex-wrap gap-3 text-muted small">
                    <span><i class="bi bi-calendar3 me-1 text-primary"></i>{{ event.date|date('d/m/Y à H:i') }}</span>
                    <span><i class="bi bi-geo-alt me-1 text-danger"></i>{{ event.location }}</span>
                    <span><i class="bi bi-people me-1 text-success"></i>{{ reservations|length }} / {{ event.seats }} places réservées</span>
                </div>
            </div>
            <div class="col-md-4 text-md-end mt-3 mt-md-0">
                {% set pct = event.seats > 0 ? (reservations|length / event.seats * 100)|round : 0 %}
                <div class="mb-1 small text-muted">Taux de remplissage : {{ pct }}%</div>
                <div class="progress" style="height:12px;">
                    <div class="progress-bar {{ pct >= 90 ? 'bg-danger' : (pct >= 60 ? 'bg-warning' : 'bg-success') }}"
                         style="width:{{ pct }}%"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="bi bi-list-check me-2"></i>Réservations ({{ reservations|length }})</h5>
        <a href="{{ path('admin_event_edit', {'id': event.id}) }}" class="btn btn-outline-warning btn-sm">
            <i class="bi bi-pencil me-1"></i>Modifier l'événement
        </a>
    </div>
    {% if reservations is empty %}
        <div class="card-body text-center py-5">
            <i class="bi bi-inbox fs-1 text-muted"></i>
            <p class="text-muted mt-3">Aucune réservation pour cet événement.</p>
        </div>
    {% else %}
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Nom</th>
                        <th>Email</th>
                        <th>Téléphone</th>
                        <th>Date réservation</th>
                    </tr>
                </thead>
                <tbody>
                    {% for reservation in reservations %}
                    <tr>
                        <td><span class="badge bg-primary">#{{ reservation.id }}</span></td>
                        <td class="fw-semibold">{{ reservation.name }}</td>
                        <td><a href="mailto:{{ reservation.email }}">{{ reservation.email }}</a></td>
                        <td>{{ reservation.phone }}</td>
                        <td class="text-muted small">{{ reservation.createdAt|date('d/m/Y H:i') }}</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</div>

<div class="mt-3">
    <a href="{{ path('admin_event_index') }}" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Retour à la liste
    </a>
</div>
</div>

{% endblock %}
