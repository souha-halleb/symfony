{% extends 'base.html.twig' %}

{% block title %}{{ mode == 'new' ? 'Nouvel événement' : 'Modifier : ' ~ event.title }} — Admin{% endblock %}

{% block body %}
<div class="container">

<nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="{{ path('admin_dashboard') }}">Dashboard</a></li>
        <li class="breadcrumb-item"><a href="{{ path('admin_event_index') }}">Événements</a></li>
        <li class="breadcrumb-item active">{{ mode == 'new' ? 'Nouveau' : 'Modifier' }}</li>
    </ol>
</nav>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-header {{ mode == 'new' ? 'bg-primary' : 'bg-warning' }} text-{{ mode == 'new' ? 'white' : 'dark' }} py-3">
                <h4 class="mb-0">
                    <i class="bi bi-{{ mode == 'new' ? 'plus-circle' : 'pencil-square' }} me-2"></i>
                    {{ mode == 'new' ? 'Créer un nouvel événement' : 'Modifier l\'événement' }}
                </h4>
            </div>
            <div class="card-body p-4">
                <form method="post" enctype="multipart/form-data" novalidate>
                    <div class="row g-3">
                        <div class="col-12">
                            <label for="title" class="form-label fw-semibold">
                                Titre <span class="text-danger">*</span>
                            </label>
                            <input type="text" class="form-control" id="title" name="title"
                                   value="{{ event.title }}" placeholder="Titre de l'événement" required>
                        </div>

                        <div class="col-12">
                            <label for="description" class="form-label fw-semibold">
                                Description <span class="text-danger">*</span>
                            </label>
                            <textarea class="form-control" id="description" name="description"
                                      rows="4" placeholder="Description détaillée…" required>{{ event.description }}</textarea>
                        </div>

                        <div class="col-md-6">
                            <label for="date" class="form-label fw-semibold">
                                Date et heure <span class="text-danger">*</span>
                            </label>
                            <input type="datetime-local" class="form-control" id="date" name="date"
                                   value="{{ event.date is defined and event.date ? event.date|date('Y-m-d\\TH:i') : '' }}" required>
                        </div>

                        <div class="col-md-6">
                            <label for="seats" class="form-label fw-semibold">
                                Nombre de places <span class="text-danger">*</span>
                            </label>
                            <input type="number" class="form-control" id="seats" name="seats"
                                   value="{{ event.seats }}" min="1" placeholder="100" required>
                        </div>

                        <div class="col-12">
                            <label for="location" class="form-label fw-semibold">
                                Lieu <span class="text-danger">*</span>
                            </label>
                            <input type="text" class="form-control" id="location" name="location"
                                   value="{{ event.location }}" placeholder="Adresse / salle / campus…" required>
                        </div>

                        <div class="col-12">
                            <label for="image" class="form-label fw-semibold">Image (optionnelle)</label>
                            {% if event.image %}
                                <div class="mb-2">
                                    <img src="/uploads/{{ event.image }}" alt="Image actuelle"
                                         class="img-thumbnail" style="max-height:120px;">
                                    <small class="text-muted ms-2">Image actuelle — sélectionnez un nouveau fichier pour la remplacer.</small>
                                </div>
                            {% endif %}
                            <input type="file" class="form-control" id="image" name="image"
                                   accept="image/jpeg,image/png,image/webp">
                            <div class="form-text">Formats acceptés : JPG, PNG, WEBP. Taille max : 2 Mo.</div>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn {{ mode == 'new' ? 'btn-primary' : 'btn-warning' }} px-4">
                            <i class="bi bi-{{ mode == 'new' ? 'plus-circle' : 'check-circle' }} me-2"></i>
                            {{ mode == 'new' ? 'Créer l\'événement' : 'Enregistrer les modifications' }}
                        </button>
                        <a href="{{ path('admin_event_index') }}" class="btn btn-outline-secondary">
                            <i class="bi bi-x-circle me-1"></i>Annuler
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
</div>

{% endblock %}
