{% extends 'base.html.twig' %}
{% block title %}Modifier la réservation{% endblock %}

{% block body %}
<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="fw-bold">
            <i class="bi bi-pencil-square me-2 text-warning"></i>Modifier la réservation #{{ reservation.id }}
        </h1>
        <a href="{{ path('admin_users') }}" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Retour
        </a>
    </div>

    <div class="card shadow-sm" style="max-width: 600px;">
        <div class="card-body p-4">
            {# FIX #21 : le formulaire original n'avait pas de token CSRF
               → vulnérabilité CSRF. On ajoute input hidden _csrf_token. #}
            <form method="post">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('edit_reservation_' ~ reservation.id) }}">

                <div class="mb-3">
                    <label class="form-label fw-semibold">Nom</label>
                    <input type="text" name="name" class="form-control"
                           value="{{ reservation.name }}" required minlength="2">
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Email</label>
                    <input type="email" name="email" class="form-control"
                           value="{{ reservation.email }}" required>
                </div>
                <div class="mb-4">
                    <label class="form-label fw-semibold">Téléphone</label>
                    <input type="text" name="phone" class="form-control"
                           value="{{ reservation.phone }}" required>
                </div>

                {% if reservation.event %}
                <div class="mb-4 p-3 bg-light rounded small text-muted">
                    <i class="bi bi-calendar-event me-1"></i>
                    Événement : <strong>{{ reservation.event.title }}</strong>
                    — {{ reservation.event.date|date('d/m/Y') }}
                </div>
                {% endif %}

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-warning">
                        <i class="bi bi-check-circle me-1"></i>Enregistrer
                    </button>
                    <a href="{{ path('admin_users') }}" class="btn btn-outline-secondary">Annuler</a>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}
