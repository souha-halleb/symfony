{% extends 'base.html.twig' %}

{% block title %}Connexion Admin — EventReservation{% endblock %}

{% block extra_css %}
.login-wrapper { min-height: 80vh; display: flex; align-items: center; justify-content: center; }
.tab-content { padding-top: 1.5rem; }
#passkey-status { font-size: .9rem; padding: .5rem; border-radius: 6px; }
{% endblock %}

{% block body %}
<div class="login-wrapper">
    <div class="col-sm-10 col-md-7 col-lg-5">

        <!-- Logo / titre -->
        <div class="text-center mb-4">
            <div class="bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
                 style="width:64px;height:64px;">
                <i class="bi bi-shield-lock fs-2"></i>
            </div>
            <h3 class="fw-bold">Espace sécurisé</h3>
            <p class="text-muted small">EventReservation — ISSAT Sousse</p>
        </div>

        <div class="card shadow">
            <div class="card-body p-4">

                <!-- Onglets Admin / Passkey -->
                <ul class="nav nav-tabs nav-justified mb-0" id="authTabs" role="tablist">
                    <li class="nav-item">
                        <button class="nav-link active" id="tab-admin" data-bs-toggle="tab"
                                data-bs-target="#pane-admin" type="button">
                            <i class="bi bi-person-lock me-1"></i>Admin (Login)
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link" id="tab-passkey" data-bs-toggle="tab"
                                data-bs-target="#pane-passkey" type="button">
                            <i class="bi bi-fingerprint me-1"></i>Passkey (Utilisateur)
                        </button>
                    </li>
                </ul>

                <div class="tab-content" id="authTabsContent">

                    <!-- ── Onglet connexion Admin (formulaire classique) ── -->
                    <div class="tab-pane fade show active" id="pane-admin">
                        {% if error %}
                            <div class="alert alert-danger">
                                <i class="bi bi-exclamation-triangle me-2"></i>{{ error.messageKey|trans(error.messageData, 'security') }}
                            </div>
                        {% endif %}

                        <form method="post" action="{{ path('admin_login') }}" novalidate>
                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                            <div class="mb-3">
                                <label for="username" class="form-label fw-semibold">
                                    <i class="bi bi-person me-1"></i>Nom d'utilisateur
                                </label>
                                <input type="text" class="form-control" id="username" name="_username"
                                       value="{{ last_username }}" autocomplete="username"
                                       placeholder="admin" required autofocus>
                            </div>

                            <div class="mb-4">
                                <label for="password" class="form-label fw-semibold">
                                    <i class="bi bi-lock me-1"></i>Mot de passe
                                </label>
                                <div class="input-group">
                                    <input type="password" class="form-control" id="password"
                                           name="_password" autocomplete="current-password"
                                           placeholder="••••••••" required>
                                    <button class="btn btn-outline-secondary" type="button"
                                            onclick="togglePwd()">
                                        <i class="bi bi-eye" id="eye-icon"></i>
                                    </button>
                                </div>
                            </div>

                            <div class="form-check mb-3">
                                <input class="form-check-input" type="checkbox"
                                       name="_remember_me" id="remember_me">
                                <label class="form-check-label small" for="remember_me">Se souvenir de moi</label>
                            </div>

                            <button type="submit" class="btn btn-primary w-100 py-2">
                                <i class="bi bi-box-arrow-in-right me-2"></i>Se connecter
                            </button>
                        </form>

                        <div class="mt-3 p-3 bg-light rounded small text-muted">
                            <i class="bi bi-info-circle me-1"></i>
                            Identifiants par défaut (fixtures) :<br>
                            <code>admin</code> / <code>admin1234</code>
                        </div>
                    </div>

                    <!-- ── Onglet Passkey ── -->
                    <div class="tab-pane fade" id="pane-passkey">
                        <div id="webauthn-warning" class="alert alert-warning d-none">
                            <i class="bi bi-exclamation-triangle me-2"></i>
                            Votre navigateur ne supporte pas WebAuthn. Utilisez Chrome 108+, Firefox 113+ ou Safari 16+.
                        </div>

                        <!-- Connexion avec Passkey existante -->
                        <div class="mb-4">
                            <h6 class="fw-semibold mb-3">
                                <i class="bi bi-fingerprint text-success me-2"></i>Se connecter avec une Passkey
                            </h6>
                            <button id="btn-login-passkey" class="btn btn-success w-100 btn-passkey py-2">
                                <i class="bi bi-shield-check me-2"></i>Utiliser ma Passkey
                            </button>
                        </div>

                        <hr class="my-4">

                        <!-- Enregistrement d'une nouvelle Passkey -->
                        <div>
                            <h6 class="fw-semibold mb-3">
                                <i class="bi bi-person-plus text-primary me-2"></i>Créer une Passkey (nouveau compte)
                            </h6>
                            <div class="mb-3">
                                <label for="passkey-email" class="form-label small fw-semibold">Email</label>
                                <input type="email" class="form-control" id="passkey-email"
                                       placeholder="votre@email.com">
                            </div>
                            <button id="btn-register-passkey" class="btn btn-outline-primary w-100 btn-passkey">
                                <i class="bi bi-key me-2"></i>Créer ma Passkey
                            </button>
                        </div>

                        <!-- Zone de statut -->
                        <div id="passkey-status" class="mt-3 d-none"></div>

                        <div class="mt-3 p-3 bg-light rounded small text-muted">
                            <i class="bi bi-info-circle me-1"></i>
                            Les Passkeys utilisent la cryptographie asymétrique (FIDO2/WebAuthn). 
                            Votre empreinte ou Face ID ne quitte jamais votre appareil.
                        </div>
                    </div>

                </div><!-- /tab-content -->
            </div><!-- /card-body -->
        </div><!-- /card -->

    </div>
</div>
{% endblock %}

{% block scripts %}
<script src="{{ asset('js/auth.js') }}"></script>
<script>
function togglePwd() {
    const input = document.getElementById('password');
    const icon  = document.getElementById('eye-icon');
    if (input.type === 'password') {
        input.type = 'text';
        icon.className = 'bi bi-eye-slash';
    } else {
        input.type = 'password';
        icon.className = 'bi bi-eye';
    }
}
</script>
{% endblock %}
