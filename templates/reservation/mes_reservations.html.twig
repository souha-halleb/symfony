{% extends 'base.html.twig' %}
{% block title %}Mes Réservations{% endblock %}
{% block body %}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="fw-bold"><i class="bi bi-ticket-perforated me-2"></i>Mes Réservations</h1>
        <a href="{{ path('user_logout') }}" class="btn btn-outline-danger btn-sm">
            <i class="bi bi-box-arrow-right me-1"></i>Déconnexion
        </a>
    </div>

    {% if reservations is empty %}
        <div class="alert alert-info">Vous n'avez aucune réservation.</div>
    {% else %}
        <div class="card shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Événement</th>
                            <th>Nom</th>
                            <th>Date réservation</th>
                            <th class="text-center">Action</th>

                        </tr>
                    </thead>
                    <tbody>
                        {% for r in reservations %}
                        <tr>
                            <td>
                                {% if r.event %}
                                    <span class="badge bg-primary">{{ r.event.title }}</span>
                                {% endif %}
                            </td>
                            <td class="fw-semibold">{{ r.name }}</td>
                            <td class="text-muted small">{{ r.createdAt|date('d/m/Y H:i') }}</td>
                             <td class="text-center">
                                <form method="post" action="{{ path('reservation_cancel', {'id': r.id}) }}"
                                      onsubmit="return confirm('Annuler cette réservation ?')">
                                    <input type="hidden" name="_token" value="{{ csrf_token('cancel' ~ r.id) }}">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-x-circle me-1"></i>Annuler
                                    </button>
                                </form>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% endif %}
</div>
{% endblock %}