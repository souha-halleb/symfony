{% extends 'base.html.twig' %}
{% block title %}Événements à venir — EventReservation{% endblock %}
{% block body %}
<div class="container">
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="fw-bold mb-1"><i class="bi bi-calendar2-event me-2 text-primary"></i>Événements</h1>
    </div>
    <span class="badge bg-primary fs-6">{{ events|length }} événement{{ events|length > 1 ? 's' : '' }}</span>
</div>
{% if events is empty %}
    <div class="text-center py-5">
        <i class="bi bi-calendar-x fs-1 text-muted"></i>
        <p class="text-muted mt-3">Aucun événement disponible pour le moment.</p>
    </div>
{% else %}
    <div class="row g-4">
        {% for event in events %}
        <div class="col-md-6 col-lg-4">
            <div class="card h-100">
                {% if event.image %}
                    <img src="/uploads/{{ event.image }}" class="event-img card-img-top" alt="{{ event.title }}">
                {% else %}
                    <div class="event-img bg-gradient d-flex align-items-center justify-content-center"
                         style="background: linear-gradient(135deg,#0d6efd22,#0d6efd44);">
                        <i class="bi bi-calendar-event" style="font-size:3rem;color:#0d6efd66;"></i>
                    </div>
                {% endif %}
                <div class="card-body">
                    <h5 class="card-title fw-bold">{{ event.title }}</h5>
                    <p class="card-text text-muted small">{{ event.description|slice(0, 120) }}{% if event.description|length > 120 %}…{% endif %}</p>
                    <ul class="list-unstyled small mb-0">
                        <li class="mb-1"><i class="bi bi-calendar3 me-2 text-primary"></i>{{ event.date|date('d/m/Y à H:i') }}</li>
                        <li class="mb-1"><i class="bi bi-geo-alt me-2 text-danger"></i>{{ event.location }}</li>
                        <li>
                            <i class="bi bi-people me-2 text-success"></i>
                            {% set available = event.availableSeats %}
                            {% if available > 0 %}
                                <span class="badge bg-success badge-seats">{{ available }} place{{ available > 1 ? 's' : '' }} disponible{{ available > 1 ? 's' : '' }}</span>
                            {% else %}
                                <span class="badge bg-danger badge-seats">Complet</span>
                            {% endif %}
                        </li>
                    </ul>
                </div>
                <div class="card-footer bg-transparent border-0 d-flex gap-2 pb-3">
                    <a href="{{ path('event_show', {'id': event.id}) }}" class="btn btn-outline-primary btn-sm flex-fill">
                        <i class="bi bi-eye me-1"></i>Détails
                    </a>
                    {% if event.availableSeats > 0 %}
                        <a href="{{ path('reservation_new', {'id': event.id}) }}" class="btn btn-success btn-sm flex-fill">
                            <i class="bi bi-ticket-perforated me-1"></i>Réserver
                        </a>
                    {% else %}
                        <button class="btn btn-secondary btn-sm flex-fill" disabled>Complet</button>
                    {% endif %}
                </div>
            </div>
        </div>
        {% endfor %}
    </div>
{% endif %}
</div>
{% endblock %}