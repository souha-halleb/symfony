APP_ENV=dev
APP_SECRET=change_me_to_a_32_chars_random_string_here

# FIX #14 : Le fichier .env original avait APP_ENV et DATABASE_URL en DOUBLE.
# Symfony prend la DERNIÈRE valeur → APP_SECRET était vide et DATABASE_URL pointait
# vers "app" au lieu de "event_reservation". Corrigé ci-dessous.
DATABASE_URL="postgresql://app_user:app_password@127.0.0.1:5432/event_reservation?serverVersion=14&charset=utf8"

# JWT
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=souhq
JWT_TOKEN_TTL=3600

# WebAuthn / Passkey
# FIX #15 : APP_DOMAIN doit correspondre EXACTEMENT au domaine utilisé dans le navigateur.
# En dev local → "localhost". En prod → "mondomaine.com" (sans https://, sans port).
APP_DOMAIN=localhost
WEBAUTHN_RP_NAME="EventReservation App"
DEFAULT_URI=http://localhost